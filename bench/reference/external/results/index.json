{
  "purpose": "Raw per-rung solver output from the external truth pipeline, kept so every reference value and every trust claim can be recomputed from the source data rather than re-solved.",
  "pipeline": "gmsh-mesh -> calculix-solve -> probe (bench/reference/external_truth.py)",
  "chain": [
    "raw-*.json  : per-case, per-rung Gmsh + CalculiX output and probe values (this directory)",
    "../external-truth-load-evidence.json : per-rung loaded areas, wall-ring exposure, CAD feature sizes, annulus verification (--stage evidence)",
    "../external-truth-audit*.json : before/after reference movement (--stage audit / --stage write)",
    "../external-truth-validate.json : the closed-form gate and the CalculiX-vs-PolyMesh cross-check",
    "../external-truth-findings.json : headline findings with their evidence",
    "../../corpus/*.json : the references themselves, each carrying metric.provenance"
  ],
  "reproduce": [
    "python bench/reference/external_truth.py --stage generate --family <family> --out <raw.json>",
    "python bench/reference/external_truth.py --stage evidence --family tube --family perforated_plate --results <raw.json> ...",
    "python bench/reference/external_truth.py --stage write --approved --results <raw.json> ... --audit <audit.json>",
    "python bench/reference/external_truth.py --stage audit --baseline <git-rev>"
  ],
