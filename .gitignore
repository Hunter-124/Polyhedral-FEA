/build*/
compile_commands.json
.cache/
# Holdout geometries are never committed or shown to the implementation loop
# (BENCHMARKS.md anti-cheat rule 1). See audits/README.md for protocol.
/bench/geometries/holdout/
/audits/local/
# VTU dumps generally ignored; campaign warehouse is tracked (git-LFS).
*.vtu
!bench/campaigns/**/runs/**/mesh.vtu
/polymesh-setup/

# machine-local graphify artifacts (committed: graph.json, GRAPH_REPORT.md,
# .graphify_labels.json, manifest.json — see CONTRIBUTING.md §8)
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.html
imgui.ini

# Accidental local CAD/smoke dumps at repo root (fixtures live under bench/, examples/)
/test-part.stl
/*.stl

# Example script VTU dumps
examples/out/

# Root-level binaries from build.bat / build.sh
/polymesh
/polymesh.exe
/polymesh-gui
/polymesh-gui.exe

# Self-improve loop run outputs (machine-local)
bench/self_improve/


# Training corpora for the learned mesh advisor (ADR-0027). Multi-GB; licence
# provenance lives in bench/advisor/corpus_manifest.json, never committed.
/bench/geometries/corpus/
/bench/advisor/dataset.csv
/bench/advisor/runs/
/bench/advisor/model.onnx
/bench/advisor/dashboard.html
/bench/advisor/.cache/
# Python bytecode from scripts/
__pycache__/
*.pyc

# Advisor campaign warehouses. The rows (results.jsonl) and the provenance
# (campaign.json, checkpoint.json) are tracked; the per-run mesh.vtu/wire.png
# are not. Batch 1 alone is ~150 MB of them and every one is regenerable from
# the committed campaign.json plus scripts/gen_primitive_corpus.py, which is
# deterministic. Curated benchmark warehouses elsewhere stay tracked.
/bench/campaigns/advisor-batch-*/runs/
/bench/campaigns/advisor-truth-*/runs/
/bench/campaigns/advisor-*/mesh_preview.pmp
